# ============================================================
# GitMind: Autonomous Code Review Agent
# Environment configuration (copy to backend/.env)
# ============================================================

# --- Runtime ---
# "production" refuses to start with an insecure configuration
ENVIRONMENT=development

# --- LLM provider ---
# "gemini" (Google API, subject to quota) or "ollama" (local model, no quota).
# Administrators can also switch provider from the dashboard: that choice is
# stored in the database and overrides this value.
LLM_PROVIDER=gemini

# --- Gemini ---
GEMINI_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Ollama (local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# Context window requested from Ollama: prompts must fit in it
OLLAMA_NUM_CTX=16384

# --- LLM calls ---
LLM_TIMEOUT_SECONDS=180
# Transient errors (timeouts, 429/5xx) and invalid structured output are retried
LLM_MAX_ATTEMPTS=3
LLM_RETRY_WAIT_SECONDS=2
# Parallel calls per agent (use 1 on machines with little memory for Ollama)
LLM_MAX_CONCURRENCY=3
# Max estimated diff tokens per call: larger diffs are split into several calls
LLM_INPUT_TOKEN_BUDGET=24000

# --- Gemini rate limiter (free tier values; not used with Ollama) ---
RATE_LIMIT_RPM_MAX=5
RATE_LIMIT_RPD_MAX=20
RATE_LIMIT_TPM_MAX=250000

# --- GitHub App (reads PRs, posts reviews) ---
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=./secrets/github_private_key.pem
# Required: webhooks without a valid signature are always rejected.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=
# Development fallback when no GitHub App is configured
GITHUB_TOKEN=

# --- Dashboard sign-in (GitHub OAuth App) ---
# Callback URL to register on GitHub: <PUBLIC_API_URL>/auth/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Who may sign in (comma-separated GitHub logins and/or organizations)
AUTH_ALLOWED_USERS=
AUTH_ALLOWED_ORGS=
# Who can clear the archive and manage API keys
AUTH_ADMIN_USERS=
# Signs session cookies. At least 32 characters in production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_TTL_HOURS=168
# Local development only: skip sign-in and treat every request as an admin.
# Refused when ENVIRONMENT=production.
AUTH_DISABLED=false

# --- Public URLs ---
PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- HTTP rate limiting ---
HTTP_RATE_LIMIT_ENABLED=true
HTTP_RATE_LIMIT_DEFAULT=120/minute
HTTP_RATE_LIMIT_TRIGGER=10/hour

# --- Review behavior ---
# true: findings wait for approval in the dashboard before being posted
HITL_ENABLED=true
REVIEW_DRAFT_PRS=false
# The bot never approves a PR by itself. When true, an "approve" verdict is
# posted as APPROVE only after a human approved it in the dashboard.
ALLOW_BOT_APPROVE=false
# Pull requests larger than this are reviewed partially (the summary lists what was skipped)
MAX_REVIEW_FILES=100
MAX_REVIEW_PATCH_CHARS=400000
# Extra comma-separated globs to skip, on top of lockfiles, generated and vendored files
REVIEW_EXCLUDE_PATTERNS=
# Critical/high findings of these categories request changes; the self-reported confidence
# threshold is off by default because it was not predictive in the evaluation
# Second LLM pass that suppresses unsupported findings (off: see docs/adr/0001)
VERIFIER_ENABLED=false
VERIFIER_MIN_CONFIDENCE=0.5
VERDICT_BLOCKING_CATEGORIES=security
VERDICT_MIN_CONFIDENCE=0.0

# --- LangSmith (optional, for tracing) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGCHAIN_PROJECT=code-review-agent

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./reviews.db
DATABASE_PATH=./reviews.db

# --- Logging ---
LOG_LEVEL=INFO
