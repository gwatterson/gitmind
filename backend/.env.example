# ============================================================
# GitMind - Autonomous Code Review Agent
# Environment Configuration
# ============================================================

# --- Gemini LLM ---
GEMINI_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Rate Limiter ---
RATE_LIMIT_RPM_MAX=5
RATE_LIMIT_RPD_MAX=20
RATE_LIMIT_TPM_MAX=250000

# --- GitHub App ---
GITHUB_APP_ID=your_app_id
GITHUB_PRIVATE_KEY_PATH=./secrets/github_private_key.pem
GITHUB_WEBHOOK_SECRET=your_webhook_secret
GITHUB_TOKEN=ghp_your_token_here

# --- LangSmith (optional - for tracing) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGCHAIN_PROJECT=code-review-agent

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./reviews.db
DATABASE_PATH=./reviews.db

# --- App ---
HITL_ENABLED=true
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
LOG_LEVEL=INFO
