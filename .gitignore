# ============================================================
# GitMind: root .gitignore
# ============================================================

# --- Environment & Secrets ---
.env
.env.local
*.pem
secrets/
backend/secrets/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/
venv/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
*.db
*.db-shm
*.db-wal

# --- Node.js ---
node_modules/
.next/
.vercel/
.pnp.js
.yarn/install-state.gz

# --- Logs ---
*.log
error.log

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db

# --- Local sample files with intentional vulnerabilities ---
/samples/vulnerable/

# --- Markdown Files ---
/TODO.md
/REQUIREMENTS.md
/PLAN.md
